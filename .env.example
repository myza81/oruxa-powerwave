# Copy to .env and adjust. .env is never committed; GitHub is the source of
# truth for code, the host's .env is the source of truth for its secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API.
# Required when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:8101,http://127.0.0.1:8101

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

STORAGE_TYPE=local

# Path *inside the container*. The host location is POWERWAVE_DATA_PATH.
STORAGE_PATH=/data

# ---------------------------------------------------------------------------
# Database (provisioned later; unused in Milestone 1)
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://powerwave_user:CHANGE_ME@postgres:5432/powerwave_db

# ---------------------------------------------------------------------------
# Compose networking
# ---------------------------------------------------------------------------
#
# Each overlay already defaults these to the right values for its environment,
# so they only need setting to override:
#
#   PROD (compose.prod.yaml)  BACKEND_PORT=8100  FRONTEND_PORT=8101
#   DEV  (compose.dev.yaml)   BACKEND_PORT=8200  FRONTEND_PORT=8201
#
# DEV and PROD therefore coexist on one host without either being configured.

POWERWAVE_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8100
FRONTEND_PORT=8101

# Base URL the browser uses to reach the API.
API_BASE_URL=http://127.0.0.1:8100

# ---------------------------------------------------------------------------
# Production only (required by compose.prod.yaml)
# ---------------------------------------------------------------------------

# Host directory bind-mounted at STORAGE_PATH.
#
# DEV must never point at the production directory. On the VPS, DEV uses
# /srv/oruxa/data/powerwave-dev; left unset, DEV falls back to a project-scoped
# named volume, which is what local Docker on a Mac should use.
POWERWAVE_DATA_PATH=/srv/oruxa/data/powerwave

# Owner of that directory, so written files are not root-owned.
POWERWAVE_UID=1000
POWERWAVE_GID=1000
