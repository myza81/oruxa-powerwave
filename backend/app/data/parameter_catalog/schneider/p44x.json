{
  "schema": "oruxa.parameter-catalog/1",
  "catalog_id": "schneider-micom-p44x-catalog",
  "version": "1.0.0",
  "lifecycle": "active",
  "profile_id": "schneider-micom-p441",
  "registry_version": "1.0.0",
  "description": "Schneider Electric MiCOM P44x (P441) distance settings, addressed by the relay's own parameter codes: CT/VT ratios, the settings basis, each zone's operating delay and phase / earth resistive reaches, and Zone P's direction. A small, well-understood subset migrated from the hand-written micom-p441-v1 profile and proven equivalent to it. Catalog-first: every target listed here is authoritative from this catalog; everything not listed (reaches that depend on the line angle, residual compensation, zone status from the scheme notes, tilts) is still read by the micom-p441-v1 profile as an extension, and is retained as 'not interpreted' when no one reads it.",
  "applicability": {
    "manufacturer": "Schneider Electric",
    "family": "MiCOM P44x",
    "model": "P441",
    "versions": [
      "*"
    ]
  },
  "identification": {
    "model_patterns": [
      "P441"
    ],
    "family_markers": [
      "MiCOM"
    ],
    "scheme_model_pattern": "(?<![A-Za-z0-9])P441(?![A-Za-z0-9])",
    "parameter_signatures": [
      {
        "name": "ddb-numbering",
        "pattern": "^DDB\\s+\\d+\\s*-\\s*\\d+$",
        "min_matches": 2
      }
    ]
  },
  "zones": {
    "static": [
      {
        "id": "Z1",
        "name": "Zone 1"
      },
      {
        "id": "Z2",
        "name": "Zone 2"
      },
      {
        "id": "Z3",
        "name": "Zone 3"
      },
      {
        "id": "Z4",
        "name": "Zone 4"
      },
      {
        "id": "ZP",
        "name": "Zone P"
      }
    ]
  },
  "distance_scope": {
    "code_prefixes": [
      "30",
      "31",
      "32"
    ]
  },
  "interpretation_notes": [
    "Zones 3 and 4 share one pair of resistive reaches (R3Ph-R4Ph, R3G-R4G); both zones cite the same settings."
  ],
