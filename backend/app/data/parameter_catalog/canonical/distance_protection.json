{
  "schema": "oruxa.canonical-registry/1",
  "registry_id": "distance_protection",
  "version": "1.0.0",
  "description": "Application-level engineering parameters of the Distance Protection import. OEM-neutral: labels, units, grouping and order here are what the review shows; the engine reads only the canonical model these parameters populate. OEM meaning lives in the OEM catalogs, never here.",
  "groups": [
    {"id": "relay", "label": "Relay / source information", "order": 10},
    {"id": "ct_vt", "label": "CT / VT", "order": 20},
    {"id": "line", "label": "Protected line", "order": 30},
    {"id": "zone", "label": "Distance zone", "order": 40},
    {"id": "compensation", "label": "Residual compensation", "order": 50}
  ],
  "parameters": [
    {"id": "relay.manufacturer", "label": "Manufacturer", "data_type": "text", "unit": "", "group": "relay", "order": 10, "scope": "document", "engine_path": "metadata.manufacturer"},
    {"id": "relay.family", "label": "Relay Family", "data_type": "text", "unit": "", "group": "relay", "order": 20, "scope": "document", "engine_path": "metadata.family"},
    {"id": "relay.model", "label": "Model", "data_type": "text", "unit": "", "group": "relay", "order": 30, "scope": "document", "engine_path": "metadata.model"},
    {"id": "relay.scheme", "label": "Scheme / Template", "data_type": "text", "unit": "", "group": "relay", "order": 40, "scope": "document", "engine_path": "metadata.scheme_name"},
    {"id": "relay.version", "label": "Firmware Version", "data_type": "text", "unit": "", "group": "relay", "order": 50, "scope": "document", "engine_path": "metadata.version"},
    {"id": "relay.active_setting_group", "label": "Active Setting Group", "data_type": "text", "unit": "", "group": "relay", "order": 60, "scope": "document", "engine_path": "metadata.active_setting_group"},

    {"id": "ct_vt.ct_primary", "label": "CT Primary", "data_type": "number", "unit": "A", "group": "ct_vt", "order": 10, "scope": "document", "engine_path": "transformers.ct_primary_a"},
    {"id": "ct_vt.ct_secondary", "label": "CT Secondary", "data_type": "number", "unit": "A", "group": "ct_vt", "order": 20, "scope": "document", "engine_path": "transformers.ct_secondary_a"},
    {"id": "ct_vt.vt_primary", "label": "VT Primary", "data_type": "number", "unit": "V", "group": "ct_vt", "order": 30, "scope": "document", "engine_path": "transformers.vt_primary_v"},
    {"id": "ct_vt.vt_secondary", "label": "VT Secondary", "data_type": "number", "unit": "V", "group": "ct_vt", "order": 40, "scope": "document", "engine_path": "transformers.vt_secondary_v"},
    {"id": "ct_vt.impedance_basis", "label": "Setting Values Basis", "data_type": "enum", "enum_type": "SettingBasis", "unit": "", "group": "ct_vt", "order": 50, "scope": "document", "engine_path": "transformers.setting_basis"},
    {"id": "ct_vt.voltage_base", "label": "Voltage Base", "data_type": "number", "unit": "V", "group": "ct_vt", "order": 60, "scope": "document", "engine_path": "transformers.voltage_base_v"},
    {"id": "ct_vt.current_base", "label": "Current Base", "data_type": "number", "unit": "A", "group": "ct_vt", "order": 70, "scope": "document", "engine_path": "transformers.current_base_a"},

    {"id": "line.length", "label": "Line Length", "data_type": "number", "unit": "", "group": "line", "order": 10, "scope": "document", "engine_path": "line.length"},
    {"id": "line.length_unit", "label": "Line Length Unit", "data_type": "text", "unit": "", "group": "line", "order": 15, "scope": "document", "engine_path": "line.length_unit"},
    {"id": "line.angle", "label": "Line Angle", "data_type": "number", "unit": "deg", "group": "line", "order": 20, "scope": "document", "engine_path": "line.line_angle_deg"},
    {"id": "line.positive_sequence_impedance", "label": "Positive-Sequence Impedance", "data_type": "impedance", "unit": "ohm", "group": "line", "order": 30, "scope": "document", "engine_path": "line.positive_sequence_impedance"},
    {"id": "line.zero_sequence_impedance", "label": "Zero-Sequence Impedance", "data_type": "impedance", "unit": "ohm", "group": "line", "order": 40, "scope": "document", "engine_path": "line.zero_sequence_impedance"},

    {"id": "distance.zone.status", "label": "Status", "data_type": "enum", "enum_type": "ZoneStatus", "unit": "", "group": "zone", "order": 10, "scope": "zone", "engine_path": "zones[].status"},
    {"id": "distance.zone.direction", "label": "Direction", "data_type": "enum", "enum_type": "ZoneDirection", "unit": "", "group": "zone", "order": 20, "scope": "zone", "engine_path": "zones[].direction"},
    {"id": "distance.zone.characteristic", "label": "Characteristic", "data_type": "enum", "enum_type": "CharacteristicType", "unit": "", "group": "zone", "order": 30, "scope": "zone", "engine_path": "zones[].characteristic.type"},
    {"id": "distance.zone.geometry_mode", "label": "Geometry Mode", "data_type": "enum", "enum_type": "GeometryMode", "unit": "", "group": "zone", "order": 35, "scope": "zone", "engine_path": "zones[].characteristic.geometry_mode", "plain": true},
    {"id": "distance.zone.reach", "label": "Reach", "data_type": "impedance", "unit": "ohm", "group": "zone", "order": 40, "scope": "zone", "engine_path": "zones[].reach", "applies_when": {"geometry_mode": "polar_reach"}},
    {"id": "distance.zone.reach_angle", "label": "Reach Angle", "data_type": "number", "unit": "deg", "group": "zone", "order": 41, "scope": "zone", "component_of": "distance.zone.reach", "applies_when": {"geometry_mode": "polar_reach"}},
    {"id": "distance.zone.earth_reach", "label": "Earth Reach", "data_type": "impedance", "unit": "ohm", "group": "zone", "order": 51, "scope": "zone", "engine_path": "zones[].earth_reach"},
    {"id": "distance.zone.zero_sequence_reach", "label": "Zero-Sequence Reach", "data_type": "impedance", "unit": "ohm", "group": "zone", "order": 52, "scope": "zone", "engine_path": "zones[].zero_sequence_reach"},
    {"id": "distance.zone.x_reach", "label": "Reactive Reach (X)", "data_type": "number", "unit": "ohm", "group": "zone", "order": 50, "scope": "zone", "engine_path": "zones[].x_reach_ohm", "applies_when": {"geometry_mode": "explicit_rx"}},
    {"id": "distance.zone.r_common", "label": "Resistive Reach", "data_type": "number", "unit": "ohm", "group": "zone", "order": 55, "scope": "zone", "engine_path": "zones[].resistive_reach.common"},
    {"id": "distance.zone.r_right", "label": "Phase-Phase Resistive Reach", "label_variants": {"explicit_rx": "Right Resistive Reach (+R)"}, "data_type": "number", "unit": "ohm", "group": "zone", "order": 60, "scope": "zone", "engine_path": "zones[].resistive_reach.phase_phase", "required_when": {"characteristic": "quadrilateral"}},
    {"id": "distance.zone.r_phase_earth", "label": "Earth Resistive Reach", "data_type": "number", "unit": "ohm", "group": "zone", "order": 65, "scope": "zone", "engine_path": "zones[].resistive_reach.phase_earth"},
    {"id": "distance.zone.r_left", "label": "Left Resistive Reach (−R)", "data_type": "number", "unit": "ohm", "group": "zone", "order": 70, "scope": "zone", "engine_path": "zones[].resistive_reach.reverse", "applies_when": {"characteristic": "quadrilateral"}, "required_when": {"characteristic": "quadrilateral"}},
    {"id": "distance.zone.common_delay", "label": "Time Delay", "data_type": "number", "unit": "s", "group": "zone", "order": 80, "scope": "zone", "engine_path": "zones[].common_timer_s"},
    {"id": "distance.zone.phase_delay", "label": "Phase Time Delay", "data_type": "number", "unit": "s", "group": "zone", "order": 81, "scope": "zone", "engine_path": "zones[].phase_timer_s"},
    {"id": "distance.zone.earth_delay", "label": "Earth Time Delay", "data_type": "number", "unit": "s", "group": "zone", "order": 82, "scope": "zone", "engine_path": "zones[].earth_timer_s"},
    {"id": "distance.zone.pp_enabled", "label": "Phase-Phase Faults", "data_type": "boolean", "unit": "", "group": "zone", "order": 90, "scope": "zone", "engine_path": "zones[].phase_phase_enabled"},
    {"id": "distance.zone.pe_enabled", "label": "Earth Faults", "data_type": "boolean", "unit": "", "group": "zone", "order": 91, "scope": "zone", "engine_path": "zones[].phase_earth_enabled"},
    {"id": "distance.zone.tilt", "label": "Tilt Angle", "data_type": "number", "unit": "deg", "group": "zone", "order": 100, "scope": "zone", "engine_path": "zones[].tilt_deg"},
    {"id": "distance.zone.r1_resistance", "label": "Positive Sequence Resistance R1", "data_type": "number", "unit": "ohm", "group": "zone", "order": 110, "scope": "zone", "engine_path": "zones[].characteristic.parameters{positive_sequence_resistance_r1}"},
    {"id": "distance.zone.directional_angle_dir", "label": "Directional Boundary Angle (Dir)", "data_type": "number", "unit": "deg", "group": "zone", "order": 120, "scope": "zone", "engine_path": "zones[].characteristic.parameters{directional_arg_dir}"},
    {"id": "distance.zone.directional_angle_neg_res", "label": "Directional Boundary Angle (Neg. Res.)", "data_type": "number", "unit": "deg", "group": "zone", "order": 121, "scope": "zone", "engine_path": "zones[].characteristic.parameters{directional_arg_neg_res}"},

    {"id": "distance.zone.comp.k0_magnitude", "label": "K0 Magnitude", "data_type": "number", "unit": "", "group": "compensation", "order": 10, "scope": "zone", "engine_path": "zones[].compensation.k0_magnitude", "compensation_kind": "k0_magnitude_angle"},
    {"id": "distance.zone.comp.k0_angle", "label": "K0 Angle", "data_type": "number", "unit": "deg", "group": "compensation", "order": 11, "scope": "zone", "engine_path": "zones[].compensation.k0_angle_deg", "compensation_kind": "k0_magnitude_angle"},
    {"id": "distance.zone.comp.kr", "label": "Kr", "data_type": "number", "unit": "", "group": "compensation", "order": 20, "scope": "zone", "engine_path": "zones[].compensation.kr", "compensation_kind": "kr_kx"},
    {"id": "distance.zone.comp.kx", "label": "Kx", "data_type": "number", "unit": "", "group": "compensation", "order": 21, "scope": "zone", "engine_path": "zones[].compensation.kx", "compensation_kind": "kr_kx"},
    {"id": "distance.zone.comp.re_rl", "label": "RE/RL", "data_type": "number", "unit": "", "group": "compensation", "order": 30, "scope": "zone", "engine_path": "zones[].compensation.re_rl", "compensation_kind": "re_rl_xe_xl"},
    {"id": "distance.zone.comp.xe_xl", "label": "XE/XL", "data_type": "number", "unit": "", "group": "compensation", "order": 31, "scope": "zone", "engine_path": "zones[].compensation.xe_xl", "compensation_kind": "re_rl_xe_xl"}
  ]
}
